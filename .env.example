# Copy this file to .env and fill in the real values.
# .env is gitignored. This example is safe to commit.

# https://console.groq.com -> API Keys -> Create API Key
# Name it claimaugment-key. You can only see the value once.
GROQ_API_KEY=your_groq_api_key_here

# Vision-capable Groq model; verify availability in your Groq account.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

PORT=5050
SECRET_KEY=replace_with_a_long_random_secret
DEBUG=True

# Needed in a later milestone, when the app is shown on a public URL.
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
